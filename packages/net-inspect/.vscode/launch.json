    "version": "0.2.0",
    "configurations": [
        {
            "name": "3. Clash Verge 节点测速 (指定测试目标)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "-clash",
                "-clash-concurrency",
                "25",
                "-clash-timeout",
                "2000",
                "-clash-hosts",
                "https://generativelanguage.googleapis.com,https://drivers.amd.com,http://objects.githubusercontent.com,http://91.108.56.199"
            ],
            "console": "integratedTerminal",
            "showLog": false
        },
        {
            "name": "1. 运行本地网络诊断 (默认交互模式)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [],
            "console": "integratedTerminal", // 必须使用集成终端以支持回车确认等交互输入
            "showLog": false
        },
        {
            "name": "2. Clash Verge 节点测速 (全自动探测模式)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "-clash"
            ],
            "console": "integratedTerminal",
            "showLog": false
        },
        {
            "name": "4. Clash Verge 节点测速 (手动指定 API 与密钥)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "-clash",
                "-clash-api",
                "127.0.0.1:7897",
                "-clash-secret",
                "your_secret_token"
            ],
            "console": "integratedTerminal",
            "showLog": false
        },
        {
            "name": "5. Clash Verge 节点测速 (高并发调优)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "-clash",
                "-clash-concurrency",
                "25",
                "-clash-timeout",
                "2000"
            ],
            "console": "integratedTerminal",
            "showLog": false
        },
        {
            "name": "Debug Active File (调试当前打开的单文件)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}